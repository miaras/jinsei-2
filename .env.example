# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional — defaults to the current general-purpose model.
OPENAI_MODEL=gpt-5.6

# Optional — powers the per-turn scene image (Flux Schnell via Replicate).
# Get a token from https://replicate.com/account/api-tokens
# The game works fine without this; turns just won't have an image.
REPLICATE_API_TOKEN=r8_your-token-here

# Optional — defaults to 3000
PORT=3000

# Set to "true" once you're serving over HTTPS (e.g. behind Caddy).
# Leave "false" for local http://localhost testing.
COOKIE_SECURE=false
