# OpenRouter — creates game turns with DeepSeek V4 Flash.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Google Cloud Text-to-Speech — WaveNet narration for NPC lines. Keep server-side.
GOOGLE_TTS_API_KEY=your-google-cloud-api-key

# Paddle — Merchant of Record billing. Create these two monthly recurring Prices in Paddle.
PADDLE_API_KEY=pdl_sdbx_your-api-key
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your-webhook-secret
PADDLE_PRICE_UNLIMITED=pri_your_499_monthly_price
PADDLE_PRICE_PICTURES=pri_your_999_monthly_price
# Approved Paddle checkout domain (for example https://jinsei.example).
APP_URL=http://localhost:3000

# Replicate — scene images for the Pictures plan only.
REPLICATE_API_TOKEN=r8_your-replicate-token

# Supabase — persistent accounts, sessions, and saves.
# Keep SUPABASE_SECRET_KEY server-side. Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://jotioxgrharwfndnxoir.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

# Optional — defaults to 3000.
PORT=3000

# Set to true when serving over HTTPS.
COOKIE_SECURE=false
